      "reference_id": "No Mapping",
      "relationship_type": "Concept Crosswalk",
      "raw_relationship_type": "Concept Crosswalk",
      "rationale": "CIP does not require users to log out on pre-determined time or description.",
      "source_locator": "Relationships-AC#row-13"
