      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "fetch-fedramp-rules",
      "script": "fetch-fedramp-2026-rules.mjs",
      "source_ids": ["fedramp-consolidated-rules", "fedramp-consolidated-rules-schema", "fedramp-legacy-index"],
      "catalog_ids": ["fedramp-2026", "fedramp-rev5"],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "fetch-nara-cui",
