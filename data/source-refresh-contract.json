  "other_remote_adapters": [
    {
      "script": "fetch-800-53-rev4-rev5-crosswalk.mjs",
      "source_ids": ["nist-800-53-rev4-rev5-crosswalk", "nist-appendix-j-rev4-rev5-crosswalk"],
      "cadence": "on_demand",
      "conditional_policy": "strict"
    },
    {
      "script": "check-commons-health.mjs",
      "source_ids": ["commons-resource-live-health"],
      "cadence": "on_demand",
      "conditional_policy": "live_probe_exception",
      "exception_reason": "HEAD and fallback GET requests measure current endpoint health and must not be satisfied from an HTTP object cache."
    }
  ]
}
