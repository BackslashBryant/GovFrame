      "source_ids": ["nist-olir-catalog", "nist-olir-submission-artifacts"],
      "catalog_ids": ["nist-800-53", "nist-800-171", "csf-2"],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "fetch-olir-mappings",
      "script": "fetch-olir-mappings.mjs",
      "source_ids": ["nist-800-171-oscal-mappings", "nist-olir-csf2-to-sp800-53", "nist-olir-csf2-to-sp800-171"],
      "catalog_ids": ["nist-800-53", "nist-800-171", "csf-2"],
      "cadence": "weekly",
      "conditional_policy": "strict"
