    },
    {
      "task_id": "fetch-nist-zero-trust",
      "script": "fetch-nist-zero-trust-pages.mjs",
      "source_ids": ["nist-sp-800-207-fragments", "nist-sp-800-207a-fragments", "nist-sp-1800-35", "nist-sp-1800-35-build-pages", "nist-zero-trust-github-branch"],
      "catalog_ids": ["nist-zt"],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "fetch-nist-structured-catalogs",
      "script": "fetch-nist-structured-catalogs.mjs",
      "source_ids": ["nist-iot-requirements-80053-mapping-draft", "nist-iot-requirements-csf11-mapping-draft", "nist-mobile-threat-catalogue", "nist-mobile-threat-catalogue-cve-list"],
      "catalog_ids": ["nist-iot-cybersecurity", "nist-mobile-threats", "nist-800-53", "csf-2"],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "hydrate-artifacts",
      "script": "hydrate-artifacts.mjs",
      "source_ids": ["official-artifact-registry-downloads"],
      "catalog_ids": [],
