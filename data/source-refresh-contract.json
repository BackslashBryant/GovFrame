{
  "schema_version": "1.0",
  "schedule": {
    "cadence": "weekly",
    "cron_utc": "17 7 * * 3",
    "workflow": ".github/workflows/ci.yml",
    "stale_source_detection_independent": true
  },
  "conditional_request_contract": {
    "implementation": "scripts/lib/strict-conditional-fetch.mjs",
    "etag": true,
    "last_modified": true,
    "success_304": "return validated cached publisher bytes with x-local-cache-status=revalidated",
    "stale_fallback": "reject",
    "missing_validators": "perform a fresh request",
    "unchanged_outputs": "compare bytes before atomic replacement"
  },
  "tasks": [
    {
      "task_id": "discover-nist-pages",
      "script": "discover-nist-pages.mjs",
      "source_ids": ["nist-pages-root"],
      "catalog_ids": [],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "discover-nist-structured-assets",
      "script": "discover-nist-structured-assets.mjs",
      "source_ids": ["nist-pages-project-pages"],
      "catalog_ids": [],
      "cadence": "weekly",
      "conditional_policy": "strict"
    },
    {
      "task_id": "observe-disa-sources",
