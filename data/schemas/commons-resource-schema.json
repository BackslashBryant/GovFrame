{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ControlCommonsDataset",
  "type": "object",
  "definitions": {
    "evidenceSection": {
      "type": "object",
      "required": ["status", "text", "sourceUrl"],
      "properties": {
        "status": { "const": "documented" },
        "text": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "releaseEvidence": {
      "type": "object",
      "required": ["status", "version", "name", "url", "publishedAt", "prerelease"],
      "properties": {
        "status": { "type": "string", "enum": ["published", "not_published", "not_documented"] },
        "version": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": ["string", "null"] },
        "prerelease": { "type": "boolean" }
      }
    }
  },
  "required": ["schemaVersion", "lastUpdated", "resources", "collections", "evidenceCatalog"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "lastUpdated": { "type": "string" },
    "evidenceCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceUrl", "locatorType", "locator", "retrievedAt", "reviewStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "locatorType": { "enum": ["canonical_url", "publisher_product_record", "heading_path", "captured_fragment", "repository_commit", "publisher_access_boundary", "publisher_lifecycle_notice"] },
          "locator": { "type": "string", "minLength": 1 },
          "retrievedAt": { "type": "string", "minLength": 1 },
          "reviewStatus": { "enum": ["reviewed", "pending", "rejected"] }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "whyCurated", "resourceIds", "icon"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "whyCurated": { "type": "string" },
          "resourceIds": { "type": "array", "items": { "type": "string" } },
          "icon": { "type": "string" },
          "libraryLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "query", "reason"],
              "properties": {
                "label": { "type": "string" },
                "query": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "shortName",
          "slug",
          "summary",
          "canonicalUrl",
          "publisher",
          "publisherType",
          "resourceLane",
          "resourceType",
          "frameworks",
          "lifecycleStages",
          "audiences",
          "artifactTypes",
          "lastCheckedAt",
          "technologyScopes",
          "searchAliases",
          "featuredCollections",
          "brandKey",
          "sourceEvidence",
          "verificationMethod",
          "presentationProfile",
          "entityKind",
          "profileId",
          "origin",
          "sourceRefs",
          "lifecycle",
          "claimEvidence"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "shortName": { "type": "string" },
          "cardPurpose": { "type": "string" },
          "slug": { "type": "string" },
          "summary": { "type": "string" },
          "whyIncluded": { "type": "string" },
          "canonicalUrl": { "type": "string" },
          "alternateUrls": { "type": "array", "items": { "type": "string" } },
          "publisher": { "type": "string" },
          "maintainer": { "type": ["string", "null"] },
          "publisherType": { "type": "string" },
          "resourceLane": {
            "type": "string",
            "enum": ["official", "open_source", "practitioner", "commercial", "legacy"]
          },
          "resourceType": { "type": "string" },
          "frameworks": { "type": "array", "items": { "type": "string" } },
          "programs": { "type": "array", "items": { "type": "string" } },
          "controlFamilies": { "type": "array", "items": { "type": "string" } },
          "lifecycleStages": { "type": "array", "items": { "type": "string" } },
          "audiences": { "type": "array", "items": { "type": "string" } },
          "artifactTypes": { "type": "array", "items": { "type": "string" } },
          "technologyScopes": { "type": "array", "items": { "type": "string" } },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "jurisdictions": { "type": "array", "items": { "type": "string" } },
          "governmentBranches": { "type": "array", "items": { "type": "string" } },
          "formats": { "type": "array", "items": { "type": "string" } },
          "accessType": {
            "type": "string",
            "enum": [
              "public",
              "free_account",
              "commercial_account",
              "cac_required",
              "dod_network_required",
              "invitation_required",
              "access_varies",
              "membership",
              "customer_only",
              "cac_or_piv",
              "paid",
              "restricted",
              "unknown"
            ]
          },
          "costType": { "type": "string", "minLength": 1 },
          "accountRequired": { "type": "boolean" },
          "authenticationRequired": { "type": "boolean" },
          "publicAccessNotes": { "type": ["string", "null"] },
          "openSource": { "type": "boolean" },
          "repositoryUrl": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "licenseUrl": { "type": ["string", "null"] },
          "redistributionPolicy": { "type": ["string", "null"] },
          "officialStatus": { "type": ["string", "null"] },
          "maturity": { "type": ["string", "null"] },
          "maintenanceStatus": {
            "type": "string",
            "enum": ["active", "maintained", "slow", "inactive", "archived", "deprecated", "superseded", "unknown"]
          },
          "currentVersion": { "type": ["string", "null"] },
          "publisherUpdatedAt": { "type": ["string", "null"] },
          "lastReleaseAt": { "type": ["string", "null"] },
          "lastCommitAt": { "type": ["string", "null"] },
          "lastCheckedAt": { "type": "string" },
          "lastChangedAt": { "type": ["string", "null"] },
          "nextCheckAt": { "type": ["string", "null"] },
          "updateMethod": { "type": ["string", "null"] },
          "updateCadence": { "type": ["string", "null"] },
          "freshnessStatus": { "type": ["string", "null"] },
          "supersedes": { "type": ["string", "null"] },
          "supersededBy": { "type": ["string", "null"] },
          "legacyReason": { "type": ["string", "null"] },
          "officialCounterparts": { "type": "array", "items": { "type": "string" } },
          "companionResources": { "type": "array", "items": { "type": "string" } },
          "communityLinks": { "type": "array", "items": { "type": "string" } },
          "trainingLinks": { "type": "array", "items": { "type": "string" } },
          "downloadLinks": { "type": "array", "items": { "type": "string" } },
          "apiLinks": { "type": "array", "items": { "type": "string" } },
          "feedLinks": { "type": "array", "items": { "type": "string" } },
          "popularitySignals": {
            "type": "object",
            "properties": {
              "stars": { "type": "number" },
              "forks": { "type": "number" },
              "subscribers": { "type": "number" },
              "citations": { "type": "number" }
            }
          },
          "editorialNotes": { "type": ["string", "null"] },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "searchAliases": { "type": "array", "items": { "type": "string" } },
          "searchKeywords": { "type": "array", "items": { "type": "string" } },
          "featuredCollections": { "type": "array", "items": { "type": "string" } },
          "parentEcosystemId": { "type": ["string", "null"] },
          "childResourceIds": { "type": "array", "items": { "type": "string" } },
          "brandKey": { "type": "string" },
          "sourceEvidence": { "type": "string" },
          "verificationMethod": {
            "type": "string",
            "enum": ["public_url", "official_repository", "manual_restricted"]
          },
          "overview": {
            "type": "object",
            "required": ["text", "sourceUrl", "sourceType", "exactPublisherText"],
            "properties": {
              "text": { "type": "string", "minLength": 20 },
              "sourceUrl": { "type": "string" },
              "sourceType": { "type": "string", "enum": ["repository_readme", "publisher_source"] },
              "exactPublisherText": { "type": "boolean" }
            }
          },
          "compatibility": {
            "type": "object",
            "required": ["status", "operatingSystems", "environments", "sourceUrl", "note"],
            "properties": {
              "status": { "enum": ["documented", "not_stated", "not_applicable"] },
              "operatingSystems": { "type": "array", "items": { "type": "string" } },
              "environments": { "type": "array", "items": { "type": "string" } },
              "sourceUrl": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "media": {
            "type": "object",
            "required": ["status", "items", "sourceUrl"],
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "not_available" } }, "required": ["status"] },
                "then": { "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
              }
            ],
            "properties": {
              "status": { "enum": ["available", "not_available"] },
              "sourceUrl": { "type": "string" },
              "reason": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "url", "alt", "sourceUrl", "sha256", "byteLength", "contentType", "width", "height", "license", "licenseBasis", "retrievedAt", "commitSha"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["publisher_screenshot"] },
                    "url": { "type": "string" },
                    "alt": { "type": "string" },
                    "sourceUrl": { "type": "string" },
                    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                    "byteLength": { "type": "integer", "minimum": 1 },
                    "contentType": { "type": "string", "pattern": "^image/" },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 },
                    "license": { "type": "string", "minLength": 1 },
                    "licenseBasis": { "type": "string", "enum": ["repository_license", "publisher_media_license"] },
                    "retrievedAt": { "type": "string" },
                    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
                  }
                }
              }
            }
          },
          "presentationProfile": {
            "type": "object",
            "required": ["profileType", "template"],
            "properties": {
              "profileType": { "type": "string" },
              "template": { "type": "string", "enum": ["tool", "reference", "training", "directory", "community", "data", "ecosystem", "destination", "artifact"] },
              "whatItDoes": { "$ref": "#/definitions/evidenceSection" },
              "whoItIsFor": { "$ref": "#/definitions/evidenceSection" },
              "limitations": { "$ref": "#/definitions/evidenceSection" }
            }
          },
          "toolProfile": {
            "type": "object",
            "properties": {
              "inputs": { "$ref": "#/definitions/evidenceSection" },
              "outputs": { "$ref": "#/definitions/evidenceSection" },
              "formats": { "$ref": "#/definitions/evidenceSection" },
              "integrations": { "$ref": "#/definitions/evidenceSection" },
              "installation": { "$ref": "#/definitions/evidenceSection" },
              "usage": { "$ref": "#/definitions/evidenceSection" },
              "license": { "$ref": "#/definitions/evidenceSection" },
              "maintenance": {
                "type": "object",
                "required": ["status", "text", "sourceUrl"],
                "properties": {
                  "status": { "type": "string" },
                  "text": { "type": "string" },
                  "sourceUrl": { "type": "string", "format": "uri" }
                }
              },
              "release": { "$ref": "#/definitions/releaseEvidence" }
            }
          },
          "repositoryEvidence": {
            "type": ["object", "null"],
            "required": ["capturedAt", "repositoryScope", "repositoryApiUrl", "commitSha", "commitUrl", "readmePath", "readmeUrl", "readmeSha256", "readmeByteLength", "sections", "media", "release", "facts"],
            "properties": {
              "capturedAt": { "type": "string" },
              "repositoryScope": { "type": "string", "enum": ["repository", "organization_profile"] },
              "repositoryApiUrl": { "type": "string", "format": "uri" },
              "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "commitUrl": { "type": "string", "format": "uri" },
              "readmePath": { "type": "string" },
              "readmeUrl": { "type": "string", "format": "uri" },
              "readmeSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "readmeByteLength": { "type": "integer", "minimum": 1 },
              "overviewExcerpt": { "type": ["string", "null"] },
              "sections": { "type": "object" },
              "media": { "type": "array" },
              "release": { "$ref": "#/definitions/releaseEvidence" },
              "facts": { "type": "object" }
            }
          },
          "automatedFields": { "type": "array", "items": { "type": "string" } },
          "manualFields": { "type": "array", "items": { "type": "string" } },
          "entityKind": { "const": "resource" },
          "profileId": { "type": "string", "pattern": "^resource\\." },
          "origin": {
            "enum": ["publisher_exact", "publisher_normalized", "publisher_derived", "atlas_editorial", "atlas_inferred"]
          },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "lifecycle": {
            "type": "object",
            "required": ["status", "evidenceRefs"],
            "properties": {
              "status": { "type": "string" },
              "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "replacedBy": { "type": "array", "items": { "type": "string" } }
            }
          },
          "claimEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["fieldPath", "origin", "evidenceRefs", "reviewStatus"],
              "properties": {
                "fieldPath": { "type": "string", "pattern": "^/" },
                "origin": {
                  "enum": ["publisher_exact", "publisher_normalized", "publisher_derived", "atlas_editorial", "atlas_inferred"]
                },
                "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "transformation": { "type": "string" },
                "reviewStatus": { "enum": ["reviewed", "pending", "rejected"] }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "resourceType": { "const": "tool" } } },
            "then": { "required": ["toolProfile"] }
          }
        ]
      }
    }
  }
}
